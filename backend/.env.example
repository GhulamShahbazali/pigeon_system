# PigeonFly backend — environment template.
# Copy to `backend/.env` (git-ignored) and fill the REAL values from the Aiven console.
# NEVER commit the real .env. Secrets rotate; a committed secret is a leak.

# ---- process ----
NODE_ENV=development
PORT=3000
PROCESS_ROLE=api            # api | worker | scheduler  (see docs/technical/performance-and-realtime.md §2)
SCHEDULER_ENABLED=false     # true on exactly ONE worker, if not running a dedicated scheduler
LOG_LEVEL=info

# ---- PostgreSQL (Aiven) ----
# Shape: postgres://USER:PASSWORD@HOST:PORT/DB?sslmode=require
# Keep connection_limit SMALL — Aiven free tier allows only ~20 total connections,
# shared across API(×2) + worker + scheduler. See environment.md.
DATABASE_URL=postgres://avnadmin:<PASSWORD>@pg-xxxx-pigeon-system.k.aivencloud.com:17963/defaultdb?sslmode=require&connection_limit=4&pool_timeout=20

# ---- Redis / Valkey (Aiven) ----
# rediss:// = TLS (required by Aiven). Valkey is Redis-compatible — ioredis + BullMQ work unchanged.
REDIS_URL=rediss://default:<PASSWORD>@valkey-xxxx-pigeon-system.d.aivencloud.com:17964

# ---- auth / JWT ----
JWT_SECRET=<generate-a-long-random-string>
FIREBASE_ADMIN_SDK_KEY=./secrets/firebase-admin.json   # path to the service-account JSON

# ---- Cloudflare R2 (media) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pigeonfly-media
R2_PUBLIC_BASE_URL=https://media.pigeonfly.app

# ---- misc ----
CORS_ORIGINS=http://localhost:3001
SENTRY_DSN=
