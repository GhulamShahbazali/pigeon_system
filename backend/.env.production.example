# PigeonFly backend — PRODUCTION environment template (DigitalOcean).
# Copy to `backend/.env.production` (git-ignored) and fill REAL values from the DO console.
# Test/dev uses Aiven (.env); production uses DigitalOcean Managed DB + Redis.
# NEVER commit the real file. Placeholders only here.

# ---- process ----
NODE_ENV=production
PORT=3000
PROCESS_ROLE=api            # overridden per container in docker-compose.prod.yml
SCHEDULER_ENABLED=false     # a dedicated scheduler container runs instead
LOG_LEVEL=info
SHUTDOWN_DRAIN_MS=8000      # on SIGTERM: readiness→down, wait, then close (LB drain)
WORKER_CONCURRENCY=10       # BullMQ worker concurrency per worker container

# ---- PostgreSQL (DigitalOcean Managed Postgres) ----
# RUNTIME uses the POOLED connection (PgBouncer, transaction mode) — port 25061, pgbouncer=true.
# connection_limit stays SMALL: it is PER PROCESS, and (api cluster + workers + scheduler)
# must together stay under the plan's connection cap. Let the DO pool absorb the fan-out.
DATABASE_URL=postgresql://doadmin:<PASSWORD>@<cluster>-pool.b.db.ondigitalocean.com:25061/pigeonfly?sslmode=require&pgbouncer=true&connection_limit=5&pool_timeout=20

# MIGRATIONS use the DIRECT connection (non-pooled, port 25060). Used only by
# `prisma migrate deploy` / `db push` / the trigram-index SQL, never at runtime.
DATABASE_DIRECT_URL=postgresql://doadmin:<PASSWORD>@<cluster>.b.db.ondigitalocean.com:25060/pigeonfly?sslmode=require

# ---- Redis / Valkey (DigitalOcean Managed Redis) ----
# rediss:// = TLS (required). SET eviction_policy = noeviction in the DO console
# (BullMQ keys must never be evicted; cache keys all carry TTLs so memory stays bounded).
REDIS_URL=rediss://default:<PASSWORD>@<cluster>.b.db.ondigitalocean.com:25061

# ---- auth / JWT ----
JWT_SECRET=<generate: openssl rand -hex 32>
FIREBASE_ADMIN_SDK_KEY=./secrets/firebase-admin.json

# ---- media ----
# Cloudflare R2 works from anywhere (free egress) — recommended, no code change.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pigeonfly-media
R2_PUBLIC_BASE_URL=https://media.pigeonfly.app
# (Alternative: DO Spaces is S3-compatible but needs a one-line endpoint change in
#  StorageService — prefer keeping R2 unless you want everything inside DO.)

# ---- misc ----
CORS_ORIGINS=https://app.pigeonfly.app
SENTRY_DSN=
