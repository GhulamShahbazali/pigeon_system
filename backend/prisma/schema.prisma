// PigeonFly — Prisma schema. Generated by hand from docs/technical/schema/*.
// Conventions: UUID PKs, snake_case columns via @map, durations/averages as Int seconds,
// soft-delete (deleted_at) where rows are referenced, hard-delete for state/engagement.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================= enums =======================
enum AuthProvider {
  google
  apple
}

enum UserRole {
  user
  superadmin
}

enum DeviceType {
  android
  ios
}

enum ScheduleType {
  every_day
  alternate_days
}

enum TournamentStatus {
  active
  completed
}

enum RecordPrivacy {
  private
  live
}

enum RecordStatus {
  open
  completed
}

enum MessageType {
  text
  voice
  image
  video
}

enum MediaKind {
  voice
  image
  video
}

enum ConversationStatus {
  pending
  accepted
}

enum ReportTargetType {
  post
  tournament
  user
  message
  record
}

enum ReportReason {
  spam
  abuse
  inappropriate
  other
}

enum ReportStatus {
  open
  reviewed
  actioned
  dismissed
}

enum AdminActionType {
  hide
  remove
  block
  unblock
  edit
  delete
  suspend
  unsuspend
}

// ======================= §1 users & social =======================
model User {
  id               String    @id @default(uuid())
  authProvider     AuthProvider @map("auth_provider")
  authProviderId   String    @map("auth_provider_id")
  email            String?
  displayName      String    @map("display_name")
  username         String    @unique
  photoUrl         String?   @map("photo_url")
  bio              String?
  city             String?
  countryCode      String?   @map("country_code")
  timezone         String    @default("Asia/Karachi")
  languageCode     String    @default("en") @map("language_code")
  role             UserRole  @default(user)
  followerCount    Int       @default(0) @map("follower_count")
  followingCount   Int       @default(0) @map("following_count")
  isSuspended      Boolean   @default(false) @map("is_suspended")
  lastActiveAt     DateTime? @map("last_active_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  permanentDeleteAt DateTime? @map("permanent_delete_at")

  devices          UserDevice[]
  tournaments      Tournament[]
  posts            Post[]
  records          PersonalRecord[]
  notifPrefs       UserNotificationPreferences?
  privacyPrefs     UserPrivacyPreferences?
  appPrefs         UserAppPreferences?

  @@unique([authProvider, authProviderId])
  @@index([countryCode])
  @@map("users")
}

model UserDevice {
  id          String     @id @default(uuid())
  userId      String     @map("user_id")
  deviceId    String     @map("device_id")
  deviceType  DeviceType @map("device_type")
  fcmToken    String?    @map("fcm_token")
  appVersion  String?    @map("app_version")
  lastUsedAt  DateTime   @default(now()) @map("last_used_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@map("user_devices")
}

model Follow {
  id         String   @id @default(uuid())
  followerId String   @map("follower_id")
  followeeId String   @map("followee_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([followerId, followeeId])
  @@index([followeeId, createdAt])
  @@index([followerId, createdAt])
  @@map("follows")
}

model Block {
  id        String   @id @default(uuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

// ======================= §2 reference =======================
model Country {
  code      String  @id
  name      String
  dialCode  String? @map("dial_code")
  flagEmoji String? @map("flag_emoji")
  @@map("countries")
}

model Language {
  code       String  @id
  name       String
  nativeName String? @map("native_name")
  isRtl      Boolean @default(false) @map("is_rtl")
  @@map("languages")
}

// ======================= §3 tournaments =======================
model Tournament {
  id                 String   @id @default(uuid())
  organizerId        String   @map("organizer_id")
  title              String
  rules              String?
  description        String?
  coverUrl           String?  @map("cover_url")
  numDays            Int      @map("num_days")
  scheduleType       ScheduleType @map("schedule_type")
  pigeonCount        Int      @map("pigeon_count")
  flyTime            String   @map("fly_time")
  endTime            String   @map("end_time")
  startDate          DateTime @map("start_date") @db.Date
  organizerContact   String?  @map("organizer_contact")
  status             TournamentStatus @default(active)
  likeCount          Int      @default(0) @map("like_count")
  viewCount          Int      @default(0) @map("view_count")
  followerCount      Int      @default(0) @map("follower_count")
  overallAvgSeconds  Int?     @map("overall_avg_seconds")
  linkSlug           String   @unique @map("link_slug")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  organizer    User   @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  days         TournamentDay[]
  participants TournamentParticipant[]
  flights      PigeonFlight[]

  @@index([status, createdAt])
  @@index([organizerId, createdAt])
  @@map("tournaments")
}

model TournamentDay {
  id           String   @id @default(uuid())
  tournamentId String   @map("tournament_id")
  dayNumber    Int      @map("day_number")
  date         DateTime @db.Date
  releaseAt    DateTime @map("release_at")
  createdAt    DateTime @default(now()) @map("created_at")
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  stats        ParticipantDayStats[]
  flights      PigeonFlight[]

  @@unique([tournamentId, dayNumber])
  @@index([tournamentId, date])
  @@map("tournament_days")
}

model TournamentParticipant {
  id                   String   @id @default(uuid())
  tournamentId         String   @map("tournament_id")
  name                 String
  photoUrl             String?  @map("photo_url")
  contactNo            String?  @map("contact_no")
  phone                String?
  address              String?
  overallAvgSeconds    Int?     @map("overall_avg_seconds")
  overallReturnedCount Int      @default(0) @map("overall_returned_count")
  position             Int?
  createdAt            DateTime @default(now()) @map("created_at")
  deletedAt            DateTime? @map("deleted_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  dayStats   ParticipantDayStats[]
  flights    PigeonFlight[]

  @@index([tournamentId, overallAvgSeconds])
  @@map("tournament_participants")
}

model ParticipantDayStats {
  id            String @id @default(uuid())
  participantId String @map("participant_id")
  dayId         String @map("day_id")
  avgSeconds    Int?   @map("avg_seconds")
  returnedCount Int    @default(0) @map("returned_count")

  participant TournamentParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  day         TournamentDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@unique([participantId, dayId])
  @@map("participant_day_stats")
}

model PigeonFlight {
  id              String   @id @default(uuid())
  tournamentId    String   @map("tournament_id")
  participantId   String   @map("participant_id")
  dayId           String   @map("day_id")
  pigeonName      String   @map("pigeon_name")
  landingTime     DateTime @map("landing_time")
  durationSeconds Int      @map("duration_seconds")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tournament  Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  participant TournamentParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  day         TournamentDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([participantId, dayId])
  @@index([dayId, durationSeconds])
  @@index([tournamentId])
  @@map("pigeon_flights")
}

model TournamentFollow {
  id           String   @id @default(uuid())
  tournamentId String   @map("tournament_id")
  userId       String   @map("user_id")
  createdAt    DateTime @default(now()) @map("created_at")
  @@unique([tournamentId, userId])
  @@index([userId, createdAt])
  @@map("tournament_follows")
}

model TournamentLike {
  id           String   @id @default(uuid())
  tournamentId String   @map("tournament_id")
  userId       String   @map("user_id")
  createdAt    DateTime @default(now()) @map("created_at")
  @@unique([tournamentId, userId])
  @@map("tournament_likes")
}

model TournamentView {
  id           String   @id @default(uuid())
  tournamentId String   @map("tournament_id")
  userId       String   @map("user_id")
  createdAt    DateTime @default(now()) @map("created_at")
  @@unique([tournamentId, userId])
  @@map("tournament_views")
}

// ======================= §4 posts =======================
model Post {
  id          String   @id @default(uuid())
  authorId    String   @map("author_id")
  content     String?
  imageUrl    String?  @map("image_url")
  likeCount   Int      @default(0) @map("like_count")
  shareCount  Int      @default(0) @map("share_count")
  viewCount   Int      @default(0) @map("view_count")
  hiddenUntil DateTime? @map("hidden_until")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([authorId, createdAt])
  @@map("posts")
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([postId, userId])
  @@map("post_likes")
}

model PostView {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([postId, userId])
  @@map("post_views")
}

model PostShare {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([postId])
  @@map("post_shares")
}

model PostHide {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([postId, userId])
  @@map("post_hides")
}

// ======================= §5 personal records =======================
model PersonalRecord {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  recordDate      DateTime @map("record_date") @db.Date
  flyTime         String   @map("fly_time")
  releaseAt       DateTime @map("release_at")
  totalPigeons    Int      @map("total_pigeons")
  privacy         RecordPrivacy @default(private)
  status          RecordStatus @default(open)
  totalAvgSeconds Int?     @map("total_avg_seconds")
  returnedCount   Int      @default(0) @map("returned_count")
  likeCount       Int      @default(0) @map("like_count")
  viewCount       Int      @default(0) @map("view_count")
  wentLiveAt      DateTime? @map("went_live_at")
  autoEndAt       DateTime? @map("auto_end_at")
  endedAt         DateTime? @map("ended_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pigeons         RecordPigeon[]

  @@index([userId, recordDate])
  @@index([privacy, status])
  @@index([autoEndAt])
  @@map("personal_records")
}

model RecordPigeon {
  id              String   @id @default(uuid())
  recordId        String   @map("record_id")
  pigeonName      String   @map("pigeon_name")
  landingTime     DateTime @map("landing_time")
  durationSeconds Int      @map("duration_seconds")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  record          PersonalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  @@index([recordId, createdAt])
  @@map("record_pigeons")
}

model RecordLike {
  id        String   @id @default(uuid())
  recordId  String   @map("record_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([recordId, userId])
  @@map("record_likes")
}

model RecordView {
  id        String   @id @default(uuid())
  recordId  String   @map("record_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([recordId, userId])
  @@map("record_views")
}

// ======================= §6 messages =======================
model Conversation {
  id             String   @id @default(uuid())
  pairKey        String   @unique @map("pair_key")
  status         ConversationStatus @default(pending)
  initiatorId    String   @map("initiator_id")
  lastMessageId  String?  @map("last_message_id")
  lastMessageAt  DateTime? @map("last_message_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  participants   ConversationParticipant[]
  messages       Message[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  id                      String   @id @default(uuid())
  conversationId          String   @map("conversation_id")
  userId                  String   @map("user_id")
  lastReadMessageId       String?  @map("last_read_message_id")
  lastReadAt              DateTime? @map("last_read_at")
  lastDeliveredMessageId  String?  @map("last_delivered_message_id")
  isMuted                 Boolean  @default(false) @map("is_muted")
  joinedAt                DateTime @default(now()) @map("joined_at")
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  type           MessageType
  body           String?
  mediaId        String?  @map("media_id")
  createdAt      DateTime @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  media          MessageMedia?

  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageMedia {
  id              String   @id @default(uuid())
  messageId       String?  @unique @map("message_id")
  kind            MediaKind
  r2Key           String   @map("r2_key")
  url             String
  thumbUrl        String?  @map("thumb_url")
  durationSeconds Int?     @map("duration_seconds")
  width           Int?
  height          Int?
  sizeBytes       Int?     @map("size_bytes")
  waveform        Json?
  expiresAt       DateTime? @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")
  message         Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
  @@map("message_media")
}

// ======================= §7 notifications =======================
model Notification {
  id           String   @id @default(uuid())
  recipientId  String   @map("recipient_id")
  type         String
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  isRead       Boolean  @default(false) @map("is_read")
  isAggregated Boolean  @default(false) @map("is_aggregated")
  createdAt    DateTime @default(now()) @map("created_at")
  actors       NotificationActor[]
  @@index([recipientId, createdAt])
  @@map("notifications")
}

model NotificationActor {
  id             String   @id @default(uuid())
  notificationId String   @map("notification_id")
  actorId        String   @map("actor_id")
  createdAt      DateTime @default(now()) @map("created_at")
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  @@unique([notificationId, actorId])
  @@map("notification_actors")
}

// ======================= §8 settings =======================
model UserNotificationPreferences {
  userId                   String  @id @map("user_id")
  pushEnabled              Boolean @default(true) @map("push_enabled")
  notifyNewFollower        Boolean @default(true) @map("notify_new_follower")
  notifyLikes              Boolean @default(true) @map("notify_likes")
  notifyFollowedTournament Boolean @default(true) @map("notify_followed_tournament")
  notifyLiveRecord         Boolean @default(true) @map("notify_live_record")
  notifyMessages           Boolean @default(true) @map("notify_messages")
  updatedAt                DateTime @updatedAt @map("updated_at")
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("user_notification_preferences")
}

model UserPrivacyPreferences {
  userId           String  @id @map("user_id")
  privateAccount   Boolean @default(false) @map("private_account")
  showOnlineStatus Boolean @default(true) @map("show_online_status")
  updatedAt        DateTime @updatedAt @map("updated_at")
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("user_privacy_preferences")
}

model UserAppPreferences {
  userId       String  @id @map("user_id")
  languageCode String  @default("en") @map("language_code")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("user_app_preferences")
}

// ======================= §9 moderation =======================
model Report {
  id         String   @id @default(uuid())
  reporterId String?  @map("reporter_id")
  targetType ReportTargetType @map("target_type")
  targetId   String   @map("target_id")
  reason     ReportReason
  note       String?
  status     ReportStatus @default(open)
  createdAt  DateTime @default(now()) @map("created_at")
  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

model UserSuspension {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  moderatorId    String?  @map("moderator_id")
  reason         String?
  suspendedUntil DateTime? @map("suspended_until")
  liftedAt       DateTime? @map("lifted_at")
  createdAt      DateTime @default(now()) @map("created_at")
  @@index([userId])
  @@map("user_suspensions")
}

model AdminActionLog {
  id         String   @id @default(uuid())
  adminId    String?  @map("admin_id")
  action     AdminActionType
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")
  @@index([adminId, createdAt])
  @@index([targetType, targetId])
  @@map("admin_actions")
}
